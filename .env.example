# 文芽 - 环境变量示例
# 复制为 .env 后按需修改：cp .env.example .env
# config.py 启动时自动读取 .env；系统环境变量优先于 .env

# Flask
# 生产环境必须设置随机密钥，可用：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key-in-production
FLASK_ENV=development            # development / production / testing
LOG_LEVEL=INFO
SQLALCHEMY_ECHO=false            # true 时打印所有 SQL（调试用）

# 数据库
# 默认 SQLite，文件位于 instance/wenya.db（相对路径基于 Flask instance 目录）
DATABASE_URL=sqlite:///wenya.db
# 使用 PostgreSQL 时改为下面这行，并安装 psycopg2-binary
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wenya

# AI 配置
# 提供商：openai / claude / aliyun / deepseek / moonshot
AI_PROVIDER=openai
AI_API_KEY=your-api-key-here
# 以下两项留空则使用所选提供商的默认地址和默认模型
AI_API_BASE=
AI_MODEL=
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.7

# 作文评分 API（与 AI 教练对话可使用不同的模型）
# 填写 SCORING_API_KEY 后评分改用下面的配置；留空的项回退到 AI_PROVIDER / 提供商默认地址 / 默认模型。
# SCORING_API_KEY 为空时评分使用上面的 AI_* 配置；两处 key 都为空时评分服务未开通（提交评分返回 503）。
# 例：通义千问（OpenAI 兼容模式）
#   SCORING_PROVIDER=aliyun
#   SCORING_API_BASE=https://maas.qianwenaiapi.com/compatible-mode/v1
#   SCORING_MODEL=qwen3.8-flash
SCORING_PROVIDER=
SCORING_API_BASE=
SCORING_API_KEY=
SCORING_MODEL=
SCORING_TEMPERATURE=0.2          # 评分需要稳定，建议 0-0.3
SCORING_MAX_TOKENS=1500
SCORING_TIMEOUT=90               # 单次请求超时（秒）
SCORING_JSON_MODE=false          # true 时请求 response_format=json_object（需模型支持）
SCORING_ENABLE_THINKING=false    # 通义千问 Qwen3 思考模式，评分建议关闭

# 增强功能开关
AI_ENABLE_MEMORY=true            # 启用长期记忆（存储在 memory_fragments 表）
AI_ENABLE_CACHE=true             # 启用 API 调用缓存（进程内共享）

# 模拟模式（仅开发测试，生产环境强制关闭）
# false：AI 不可用时评分接口返回 503，作文保留为草稿，不保存任何分数
# true ：AI 不可用时返回带【模拟】标记的评分/回复（置信度 0、需人工复审）
AI_MOCK_MODE=false

# 社区作品审核：true 时通过内容安全检查即自动公开；false 时需人工审核（生产环境建议 false）
COMMUNITY_AUTO_APPROVE=false

# 内容安全（百度内容审核）
CONTENT_SAFE_API_KEY=your-bce-api-key
CONTENT_SAFE_ENABLED=false

# 限流存储（生产环境建议 redis://localhost:6379/0）
REDIS_URL=memory://

# 跨域来源（逗号分隔；开发时前端走 Vite 代理，可保持 *）
CORS_ORIGINS=*

# 合规公示
ICP_NUMBER=
ALGORITHM_NUMBER=
